{
  "engine": "poll",
  "rpc": {
    "endpoint": "https://rpc.shyft.to?api_key=YOUR_SHYFT_API_KEY"
  },
  "poll_interval_seconds": 5,
  "geyser": {
    "endpoint": "your-shyft-grpc-endpoint.example.com:443",
    "x_token": "YOUR_SHYFT_X_TOKEN"
  },
  "lag_experiment": {
    "hypothetical_sol_in": 0.5,
    "lag_scenarios_ms": [100, 300, 500, 2000],
    "firehose": true,
    "max_tx_age_ms": 5000,
    "csv_path": "lag_samples.csv"
  },
  "paper_trade": {
    "execution_lag_ms": 1500,
    "csv_path": "paper_trades.csv",
    "position_timeout_minutes": 10080,
    "state_path": "paper_trade_state.json"
  },
  "tracked_wallets": [
    { "label": "cupsy", "pubkey": "REPLACE_WITH_ACTUAL_WALLET_PUBKEY" }
  ]
}
